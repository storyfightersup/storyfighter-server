<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- StoryFighter (user 2026-10-27, docs/MODERATION.md): !ban also bans the PCs (hwid) the account was seen on
         (server.moderation.StoryBans). hwidbans.aid = the account whose !ban added the row, so !unban removes only
         those rows. Rows without aid (older or other tools) are never removed by !unban.
         Pitfall: never edit db/tables/*.sql, because Liquibase checks their checksums and the server stops starting. -->
    <changeSet id="ext-025-hwidbans-aid" author="storyfighter">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="hwidbans" columnName="aid"/>
            </not>
        </preConditions>
        <sql>
            ALTER TABLE hwidbans ADD COLUMN aid INT NULL DEFAULT NULL, ADD KEY idx_hwidbans_aid (aid);
        </sql>
    </changeSet>

</databaseChangeLog>
