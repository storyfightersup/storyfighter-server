<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- StoryFighter anti-cheat #21 (2026-10-28, docs/ANTICHEAT.md, server.anticheat.Suspects): counts of watch hits
         for the GM command !suspects [days]. One row per hero, day and check.
         day  = days since 1970-01-01 (UTC); kind 0 move check, 1 attack rate, 2 pickup refused (far / rate), 3 macro
         watch; hits = how many times that day; name = the hero's name when last counted (the list stays readable
         after a rename or a deleted hero). Rows older than log_keep_days are deleted by server.starter.StoryLogCleanup.
         Pitfall: never edit db/tables/*.sql, because Liquibase checks their checksums and the server stops starting. -->
    <changeSet id="ext-026-story-suspects" author="storyfighter">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="storysuspects"/>
            </not>
        </preConditions>
        <sql>
            CREATE TABLE storysuspects
            (
                charid INT         NOT NULL,
                day    INT         NOT NULL,
                kind   TINYINT     NOT NULL,
                hits   INT         NOT NULL DEFAULT 0,
                name   VARCHAR(13) NOT NULL DEFAULT '',
                PRIMARY KEY (charid, day, kind),
                KEY idx_storysuspects_day (day)
            );
        </sql>
    </changeSet>

</databaseChangeLog>
